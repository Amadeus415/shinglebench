# Copy to .env. Everything is optional: with no keys, every provider runs as a deterministic mock.

# --- models under test / judges (config/models.yaml lists which env var each model needs) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_BASE_URL=        # e.g. http://localhost:8001/v1 for vLLM, or a hosted OpenAI-compatible endpoint

# Judges (comma-separated model names from config/models.yaml). Default: two mock judges.
JUDGE_MODELS=mock-judge-a,mock-judge-b
# Product QA agent model (real model name, or mock-qa for deterministic probes)
QA_MODEL=mock-qa
# Simulated-market persona model (mock-simulator = structured demand model only)
SIMULATOR_MODEL=mock-simulator

# --- shared services ---
IMAGE_PROVIDER=mock            # mock | openai (uses OPENAI_API_KEY)
PAYMENTS_PROVIDER=mock         # mock | stripe (test keys only)
STRIPE_SECRET_KEY=             # must start with sk_test_
RESEARCH_MODE=offline          # offline | online
SEARCH_API_KEY=                # Brave Search API key for online research

# --- infrastructure ---
SANDBOX_BACKEND=auto           # auto | docker | local
SANDBOX_IMAGE=shingle-sandbox:latest
DATABASE_URL=                  # default sqlite:///var/shingle.db ; e.g. postgresql+psycopg://user:pw@host/db
SHINGLE_DATA_DIR=              # default ./var
APP_URL=http://localhost:8000
SECRET_KEY=change-me
ADMIN_PASSWORD=admin
GRADER_PASSWORD=grader
