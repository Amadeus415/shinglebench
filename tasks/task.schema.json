{
  "$defs": {
    "AcceptanceCriterion": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z0-9_]+$",
          "title": "Id",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "probe": {
          "anyOf": [
            {
              "$ref": "#/$defs/Probe"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "description"
      ],
      "title": "AcceptanceCriterion",
      "type": "object"
    },
    "Budget": {
      "additionalProperties": false,
      "properties": {
        "total_usd": {
          "description": "Simulated cash for the whole episode",
          "exclusiveMinimum": 0,
          "title": "Total Usd",
          "type": "number"
        },
        "ad_budget_usd": {
          "description": "Suggested share for paid ads",
          "minimum": 0,
          "title": "Ad Budget Usd",
          "type": "number"
        }
      },
      "required": [
        "total_usd",
        "ad_budget_usd"
      ],
      "title": "Budget",
      "type": "object"
    },
    "Category": {
      "enum": [
        "digital_product",
        "local_service",
        "physical_product",
        "b2b_service",
        "info_community",
        "open_ended"
      ],
      "title": "Category",
      "type": "string"
    },
    "CheckId": {
      "enum": [
        "site_loads",
        "links",
        "console",
        "lighthouse",
        "mobile",
        "forms",
        "checkout",
        "product_qa",
        "ad_compliance",
        "integrity",
        "supplier"
      ],
      "title": "CheckId",
      "type": "string"
    },
    "Constraints": {
      "additionalProperties": false,
      "properties": {
        "legal": {
          "items": {
            "type": "string"
          },
          "title": "Legal",
          "type": "array"
        },
        "brand": {
          "items": {
            "type": "string"
          },
          "title": "Brand",
          "type": "array"
        },
        "scope": {
          "items": {
            "type": "string"
          },
          "title": "Scope",
          "type": "array"
        }
      },
      "title": "Constraints",
      "type": "object"
    },
    "Deliverable": {
      "enum": [
        "website",
        "product",
        "brand_doc",
        "business_plan",
        "launch_plan",
        "ad_campaign",
        "product_images",
        "supplier_order",
        "checkout",
        "booking_flow",
        "contact_form"
      ],
      "title": "Deliverable",
      "type": "string"
    },
    "EpisodeBudget": {
      "additionalProperties": false,
      "properties": {
        "max_steps": {
          "default": 120,
          "minimum": 10,
          "title": "Max Steps",
          "type": "integer"
        },
        "max_tokens": {
          "default": 2000000,
          "minimum": 10000,
          "title": "Max Tokens",
          "type": "integer"
        },
        "max_cost_usd": {
          "default": 25.0,
          "exclusiveMinimum": 0,
          "title": "Max Cost Usd",
          "type": "number"
        },
        "max_wall_clock_min": {
          "default": 120,
          "minimum": 1,
          "title": "Max Wall Clock Min",
          "type": "integer"
        },
        "simulated_weeks": {
          "default": 3,
          "maximum": 12,
          "minimum": 1,
          "title": "Simulated Weeks",
          "type": "integer"
        }
      },
      "title": "EpisodeBudget",
      "type": "object"
    },
    "GraderNotes": {
      "additionalProperties": false,
      "properties": {
        "great_looks_like": {
          "items": {
            "type": "string"
          },
          "minItems": 2,
          "title": "Great Looks Like",
          "type": "array"
        },
        "common_failures": {
          "items": {
            "type": "string"
          },
          "minItems": 2,
          "title": "Common Failures",
          "type": "array"
        },
        "market_context": {
          "description": "What a grader should know about this place/market",
          "title": "Market Context",
          "type": "string"
        }
      },
      "required": [
        "great_looks_like",
        "common_failures",
        "market_context"
      ],
      "title": "GraderNotes",
      "type": "object"
    },
    "Market": {
      "additionalProperties": false,
      "properties": {
        "region": {
          "description": "Human-readable market, e.g. 'Mission District, San Francisco, CA, USA'",
          "title": "Region",
          "type": "string"
        },
        "country": {
          "description": "ISO 3166-1 alpha-2",
          "pattern": "^[A-Z]{2}$",
          "title": "Country",
          "type": "string"
        },
        "city": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "City"
        },
        "neighborhood": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Neighborhood"
        },
        "lat": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lat"
        },
        "lon": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lon"
        },
        "service_radius_km": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Service Radius Km"
        },
        "currency": {
          "default": "USD",
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        },
        "languages": {
          "items": {
            "type": "string"
          },
          "title": "Languages",
          "type": "array"
        },
        "audience_hint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Shown to the model; may be vague on purpose",
          "title": "Audience Hint"
        }
      },
      "required": [
        "region",
        "country"
      ],
      "title": "Market",
      "type": "object"
    },
    "Probe": {
      "additionalProperties": false,
      "description": "Deterministic hint so the offline QA agent can test a criterion without an LLM.",
      "properties": {
        "kind": {
          "enum": [
            "page_contains",
            "element_exists",
            "interact",
            "form_submits",
            "checkout_completes"
          ],
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "default": "/",
          "title": "Path",
          "type": "string"
        },
        "any_text": {
          "items": {
            "type": "string"
          },
          "title": "Any Text",
          "type": "array"
        },
        "selector": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Selector"
        },
        "inputs": {
          "description": "Values typed into the first visible inputs",
          "items": {
            "type": "string"
          },
          "title": "Inputs",
          "type": "array"
        }
      },
      "required": [
        "kind"
      ],
      "title": "Probe",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "id": {
      "pattern": "^[a-z0-9][a-z0-9-]{2,60}$",
      "title": "Id",
      "type": "string"
    },
    "version": {
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    },
    "split": {
      "enum": [
        "dev",
        "heldout"
      ],
      "title": "Split",
      "type": "string"
    },
    "category": {
      "$ref": "#/$defs/Category"
    },
    "tier": {
      "enum": [
        1,
        2,
        3
      ],
      "title": "Tier",
      "type": "integer"
    },
    "title": {
      "description": "Internal title; not shown to the model",
      "title": "Title",
      "type": "string"
    },
    "brief": {
      "description": "The brief exactly as the model sees it",
      "minLength": 200,
      "title": "Brief",
      "type": "string"
    },
    "market": {
      "anyOf": [
        {
          "$ref": "#/$defs/Market"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "budget": {
      "$ref": "#/$defs/Budget"
    },
    "deliverables": {
      "items": {
        "$ref": "#/$defs/Deliverable"
      },
      "minItems": 3,
      "title": "Deliverables",
      "type": "array"
    },
    "required_pages": {
      "description": "Slugs of key pages, e.g. pricing, contact",
      "items": {
        "type": "string"
      },
      "title": "Required Pages",
      "type": "array"
    },
    "acceptance_criteria": {
      "items": {
        "$ref": "#/$defs/AcceptanceCriterion"
      },
      "minItems": 2,
      "title": "Acceptance Criteria",
      "type": "array"
    },
    "constraints": {
      "$ref": "#/$defs/Constraints"
    },
    "episode": {
      "$ref": "#/$defs/EpisodeBudget"
    },
    "grader_notes": {
      "$ref": "#/$defs/GraderNotes"
    },
    "checks": {
      "items": {
        "$ref": "#/$defs/CheckId"
      },
      "title": "Checks",
      "type": "array"
    },
    "canary": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Contamination canary; required for held-out tasks",
      "title": "Canary"
    },
    "tags": {
      "items": {
        "type": "string"
      },
      "title": "Tags",
      "type": "array"
    }
  },
  "required": [
    "id",
    "version",
    "split",
    "category",
    "tier",
    "title",
    "brief",
    "budget",
    "deliverables",
    "acceptance_criteria",
    "grader_notes",
    "checks"
  ],
  "title": "Task",
  "type": "object"
}